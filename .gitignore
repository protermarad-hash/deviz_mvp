# Android release signing — NICIODATĂ în git!
key.properties
android/key.properties
*.keystore
*.jks

# Node.js dependencies (Firebase Functions)
node_modules/
functions/node_modules/

# Fișiere backup create de agentul Claude Code — TOATE variantele de sufix.
# Acoperă: .bak, .bak2..bak5, .bak_labels, .bak_usermgmt, .bak_20260705_...,
#          .diagbak2 și orice sufix viitor care conține „bak".
# NOTĂ: „*.bak" singur NU prinde „.bak2/.bak3" (se termină în „bak2", nu „bak");
#       de aceea folosim „*.bak*" (orice conține „.bak") + „*.diagbak*".
*.bak*
*.diagbak*
*.cap_bak
# Excepție: fișierele .bak YAML/TOML de configurare dacă există
!*.yaml.bak

# Fișiere debug și log-uri locale
debug_log.txt
*.debug.txt

# Snapshot-uri baze de date locale
snapshot_baza_*/

# Backup-uri/exporturi Firestore cu date reale de producție — NICIODATĂ în git.
# Pattern-uri generice (nu doar numele găsite azi) — acoperă orice timestamp
# viitor (ex: 20260711_124219, 2026-07-05T1103) și orice client (PRO TERM/Costel).
backups_firestore/
firestore_backup*.json

# Windows build artifacts (generate automat)
windows/x64/
x64/Release/

# Config build separat client Costel Costea — NU în git (date Firebase izolate)
android/app/google-services-costel.json
android/app/src/costel/google-services.json
lib/firebase_options_costel.dart
android/app/google-services.bak.json
build/proventaris-costel.apk
build/proventaris-windows-costel.zip
