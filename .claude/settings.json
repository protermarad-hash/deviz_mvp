{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Write|Edit|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-credentials.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dart format . && flutter analyze 2>&1 | tail -20",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
